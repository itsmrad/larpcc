{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itsmrad/larpcc/blob/main/docs/contracts/cli-v1.schema.json",
  "title": "Larp CLI JSON v1 (prospective; import OUT OF SCOPE)",
  "description": "Exactly one envelope per invocation. Local metadata only; never native provider output. See cli-v1.md.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "description": "Canonical decimal u64, at most 18446744073709551615; never reused. String prevents Swift/JS precision loss."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "description": "Windows reserved device names and larp are additionally refused."
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "binding": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "detected_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "unbound",
            "ok",
            "invalid"
          ]
        },
        "qualified": {
          "const": false
        }
      },
      "required": [
        "path",
        "recorded_version",
        "detected_version",
        "state",
        "qualified"
      ],
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "state": {
          "enum": [
            "ok",
            "missing",
            "unsafe"
          ]
        }
      },
      "required": [
        "enabled",
        "path",
        "state"
      ],
      "additionalProperties": false
    },
    "alias": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "surface": {
          "enum": [
            "cli",
            "desktop"
          ]
        },
        "path": {
          "type": "string"
        },
        "state": {
          "enum": [
            "ok",
            "missing",
            "drift",
            "incompatible"
          ]
        }
      },
      "required": [
        "name",
        "profile_id",
        "surface",
        "path",
        "state"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "state": {
          "enum": [
            "active",
            "deleting"
          ]
        },
        "surfaces": {
          "type": "object",
          "properties": {
            "cli": {
              "$ref": "#/$defs/surface"
            },
            "desktop": {
              "$ref": "#/$defs/surface"
            }
          },
          "required": [
            "cli",
            "desktop"
          ],
          "additionalProperties": false
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "desktop_binding": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "id",
        "name",
        "provider",
        "state",
        "surfaces",
        "aliases",
        "desktop_binding"
      ],
      "additionalProperties": false
    },
    "switch": {
      "type": "object",
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "profile_id",
        "enabled"
      ],
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "transport": {
          "enum": [
            "stdio",
            "http"
          ]
        },
        "secret_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "env",
                  "keychain"
                ]
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "switches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/switch"
          }
        },
        "state": {
          "enum": [
            "ok",
            "drift",
            "invalid"
          ]
        }
      },
      "required": [
        "name",
        "transport",
        "secret_refs",
        "switches",
        "state"
      ],
      "additionalProperties": false
    },
    "skill": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "switches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/switch"
          }
        },
        "state": {
          "enum": [
            "ok",
            "drift",
            "invalid"
          ]
        }
      },
      "required": [
        "name",
        "sha256",
        "switches",
        "state"
      ],
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        }
      },
      "required": [
        "id",
        "name",
        "provider"
      ],
      "additionalProperties": false
    },
    "matrix": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "enabled": {
                "type": "array",
                "items": {
                  "type": "boolean"
                }
              }
            },
            "required": [
              "name",
              "enabled"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "profiles",
        "rows"
      ],
      "additionalProperties": false
    },
    "detection": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "surface": {
          "enum": [
            "cli",
            "desktop"
          ]
        },
        "binding": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "provider",
        "surface",
        "binding"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "profile_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "$ref": "#/$defs/name"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "changed",
        "profile_id",
        "name",
        "warnings"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/profile"
            },
            {
              "type": "null"
            }
          ]
        },
        "detected_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detection"
          }
        },
        "native_auth": {
          "const": "not_observed"
        },
        "native_rows": {
          "type": "array",
          "maxItems": 0
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "profile",
        "detected_versions",
        "native_auth",
        "native_rows",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "usage",
            "confirmation_required",
            "not_found",
            "conflict",
            "busy",
            "unsafe_path",
            "forbidden_source",
            "drift",
            "qualification_pending",
            "json_native_io",
            "secret_literal",
            "secret_reference",
            "unsupported",
            "too_large",
            "recovery_required",
            "io",
            "corrupt",
            "newer_schema",
            "exhausted",
            "ssh_unavailable",
            "ssh_failed",
            "remote_larp_missing",
            "remote_incompatible",
            "remote_timeout",
            "remote_output",
            "remote_outcome_unknown",
            "catalog_unavailable"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "surface": {
          "const": "desktop"
        },
        "outcome": {
          "enum": [
            "launched",
            "focused"
          ]
        },
        "native_auth": {
          "const": "not_observed"
        }
      },
      "required": [
        "profile_id",
        "provider",
        "surface",
        "outcome",
        "native_auth"
      ],
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "ssh": {
          "type": "object",
          "properties": {
            "destination": {
              "type": "string"
            },
            "resolved": {
              "type": "string"
            }
          },
          "required": [
            "destination",
            "resolved"
          ],
          "additionalProperties": false
        },
        "larp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "larpcc_home": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "ssh",
        "larp",
        "larpcc_home",
        "identity_file"
      ],
      "additionalProperties": false
    },
    "host_status": {
      "enum": [
        "ok",
        "unreachable",
        "larp_missing",
        "incompatible"
      ]
    },
    "host_mutation": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "profile_id": {
          "type": "null"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      },
      "required": [
        "changed",
        "profile_id",
        "name",
        "warnings"
      ],
      "additionalProperties": false
    }
  },
